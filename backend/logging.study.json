{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {"()": "uvicorn.logging.DefaultFormatter", "fmt": "%(levelprefix)s %(message)s", "use_colors": null},
    "access": {"()": "uvicorn.logging.AccessFormatter", "fmt": "%(levelprefix)s %(client_addr)s - \"%(request_line)s\" %(status_code)s"},
    "line": {"format": "%(message)s"}
  },
  "handlers": {
    "default": {"formatter": "default", "class": "logging.StreamHandler", "stream": "ext://sys.stderr"},
    "access": {"formatter": "access", "class": "logging.StreamHandler", "stream": "ext://sys.stdout"},
    "sessionless_file": {
      "class": "logging.handlers.TimedRotatingFileHandler",
      "filename": "data/study-logs/sessionless/backend-calls.jsonl",
      "when": "midnight", "backupCount": 0, "utc": true, "encoding": "utf-8", "delay": true,
      "formatter": "line"
    },
    "sessionless_queue": {"class": "logging.handlers.QueueHandler", "handlers": ["sessionless_file"]}
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO"},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false},
    "flatland.study.calls": {"level": "INFO", "handlers": ["sessionless_queue"], "propagate": false}
  },
  "flatland_session_handler": {
    "class": "logging.handlers.TimedRotatingFileHandler",
    "filename": "{session_dir}/backend-calls.jsonl",
    "when": "midnight", "backupCount": 0, "utc": true, "encoding": "utf-8"
  }
}
